# Python bytecode
__pycache__/
*.pyc
*.pyo
*.so

# Virtual environments
.venv/
venv/

# Environment variables
.env
.env.*
.envrc
*.pem
!.env.example

# IDE
.vscode/
.idea/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Linting
.ruff_cache/

# Claude Code / local tooling state
# Ignore .claude/* by default, but track the team-shared guardrail hooks
# and their settings. Personal state (skills/, worktrees/) stays local.
.claude/*
!.claude/hooks/
!.claude/hooks/**
!.claude/settings.json
.playwright-mcp/
.remember/

# uv temp lockfiles (not the main nautilus/uv.lock)
/uv-*.lock

# Data & catalog (generated/downloaded)
/catalog/
/data/
*.parquet
*.csv.gz
# Test fixture catalogs ARE checked in (small, deterministic, hermetic CI)
!tests/**/fixtures/**/*.parquet

# Jupyter
.ipynb_checkpoints/
*_executed.ipynb

# macOS
.DS_Store

# Build artifacts
build/
dist/
*.egg-info/

# Ralph agent state
.agent/
