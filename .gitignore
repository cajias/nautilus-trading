# Python bytecode
__pycache__/
*.pyc
*.pyo
*.so

# Virtual environments
.venv/
venv/

# Environment variables
.env
.env.*
.envrc
*.pem
!.env.example

# IDE
.vscode/
.idea/

# Testing
.pytest_cache/
.pytest-tmp/
pytest-of-*/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Linting
.ruff_cache/

# Claude Code / local tooling state
# Ignore .claude/* by default, but track the team-shared guardrail hooks
# and their settings. Personal state (skills/, worktrees/) stays local.
.claude/*
!.claude/hooks/
!.claude/hooks/**
!.claude/settings.json
.playwright-mcp/
.remember/
.superpowers/

# uv temp lockfiles (not the main nautilus/uv.lock)
/uv-*.lock

# Data & catalog (generated/downloaded)
/catalog/
/data/
*.parquet
*.csv.gz
# Test fixture catalogs ARE checked in (small, deterministic, hermetic CI)
!tests/**/fixtures/**/*.parquet

# Jupyter
.ipynb_checkpoints/
*_executed.ipynb

# macOS
.DS_Store

# Build artifacts
build/
dist/
*.egg-info/

# SWE iterative team runtime state (per-worktree, never committed)
# Replaces the previous broad `.agent/` ignore — we need `.agent/roles/*.md`
# and `.agent/team-state.template.md` to be committed, so we ignore specific
# runtime files instead of the whole directory.
.agent/team-state.md
.agent/history/*
!.agent/history/.gitkeep
# Keep Ralph's scratchpad ignored (previously covered by broad .agent/ ignore):
.agent/scratchpad.md


# APM dependencies (reproducible from apm.yml + apm.lock.yaml via `apm install`)
# APM-deployed .claude/agents/, .claude/skills/, .claude/commands/ are already
# ignored by the .claude/* rule above.
apm_modules/
.eval/
