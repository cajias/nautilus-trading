# Binance API credentials — production
# BINANCE_API_KEY="your-production-key"
# BINANCE_API_SECRET="your-production-secret"

# Binance API credentials — testnet (recommended for development)
# BINANCE_TESTNET_API_KEY="your-testnet-key"
# BINANCE_TESTNET_API_SECRET="your-testnet-secret"

# Optional: override default catalog directory
# NAUTILUS_CATALOG_DIR="./catalog"
