# ===================================
# NautilusTrader - Environment Config
# ===================================

# --- Binance (Production) ---
# Required for live trading. Get keys at https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# --- Binance (Testnet) ---
# Use for development! Get keys at https://testnet.binance.vision/
# Testnet has free test funds — always develop here first.
BINANCE_TESTNET_API_KEY=""
BINANCE_TESTNET_API_SECRET=""
# Path to Ed25519 private key PEM (required for user-data WebSocket)
BINANCE_TESTNET_ED25519_KEY_PATH=/absolute/path/to/ed25519_private.pem

# --- Binance Configuration ---
# Account type: SPOT, MARGIN, ISOLATED_MARGIN, USDT_FUTURES, COIN_FUTURES
BINANCE_ACCOUNT_TYPE="SPOT"
# Starting capital for backtests (in USDT)
BACKTEST_STARTING_BALANCE="500"

# --- TimesFM (Optional) ---
# TimesFM uses HuggingFace for model weights.
# Set token if using gated models (public models don't need this).
# Get token at https://huggingface.co/settings/tokens
HF_TOKEN=""
# Backend: "cpu", "gpu", or "tpu"
TIMESFM_BACKEND="cpu"

# --- General ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
