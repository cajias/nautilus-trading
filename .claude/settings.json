{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-guard-writes.sh",
            "timeout": 5,
            "statusMessage": "Checking write target…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-format-lint.sh",
            "timeout": 30,
            "statusMessage": "ruff format + fix…"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-typecheck.sh",
            "timeout": 60,
            "statusMessage": "mypy type-check…"
          }
        ]
      }
    ]
  }
}
